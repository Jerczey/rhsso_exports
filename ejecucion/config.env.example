# Copiar a config.env y ajustar para el entorno del cliente.
# cp config.env.example config.env

# --- RHSSO ---
RHSSO_HOME=/opt/MW/rhsso/rh-sso-7.6.12
KC_SERVER=http://127.0.0.1:8080/auth
KC_ADMIN=admin
KC_ADMIN_PASSWORD=changeme
KC_REALM=mi-realm
JBOSS_CONTROLLER=127.0.0.1:9990
SERVER_CONFIG=standalone.xml

# --- PostgreSQL (podman) ---
DB_TYPE=pg
PG_CONTAINER=my-postgres
PG_USER=yurek
PG_DB=rhsso

