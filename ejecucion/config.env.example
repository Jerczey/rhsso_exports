# Copiar a config.env y ajustar para el entorno del cliente.
# cp config.env.example config.env

# --- RHSSO ---
RHSSO_HOME=/opt/MW/rhsso/rh-sso-7.6.12
KC_SERVER=http://127.0.0.1:8080/auth
KC_ADMIN=admin
KC_ADMIN_PASSWORD=changeme
KC_REALM=mi-realm
JBOSS_CONTROLLER=127.0.0.1:9990
SERVER_CONFIG=standalone.xml

# --- PostgreSQL (Red Hat catalog / podman, lab port 5433) ---
DB_TYPE=pg
PG_CONTAINER=my-postgres
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=yurek
PG_DB=rhsso
PG_IMAGE=registry.access.redhat.com/hi/postgresql:17
TZ=America/Santiago

# --- Microsoft SQL Server (alternativa) ---
# DB_TYPE=mssql
# MSSQL_HOST=sqlserver.ejemplo.local
# MSSQL_PORT=1433
# MSSQL_DB=rhsso
# MSSQL_USER=rhsso_read
# MSSQL_PASSWORD=changeme
# MSSQL_TRUST_CERT=true

# --- Chequeos sintéticos (opcional, monitoreo/monitoreo-*.sh) ---
# PG_PASSWORD=changeme
# SYNTH_CLIENT_ID=mi-app
# SYNTH_USER=usuario.prueba
